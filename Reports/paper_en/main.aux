\@writefile{toc}{\contentsline {paragraph}{(i) The degradation is dominated by one class.}{12}{table.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(ii) The model applies a conservative N3 decision in SHHS1.}{12}{table.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(iii) The N3 deficit persists across model families.}{12}{table.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(iv) Label-prior shift is plausible but not sufficient as an explanation.}{12}{table.caption.15}\protected@file@percent }
