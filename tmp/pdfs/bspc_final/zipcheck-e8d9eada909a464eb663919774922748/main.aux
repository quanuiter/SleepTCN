\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {End-to-end processing pipeline for the proposed ResNet-1D--TCN single-channel sleep staging framework (E3 configuration).} The raw continuous EEG signal is sequentially preprocessed (band-pass filtered, clipped, and scaled), segmented into 30\,s epochs (3{,}000 samples), encoded into 128-dimensional feature vectors by a 1D-ResNet, and temporally modeled by a six-block non-causal TCN with a 253-epoch receptive field before final Softmax classification. The schematic was drawn in TikZ with OpenAI Codex assistance; it depicts processing steps, not measured signals or predictions.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{4}{\textbf {End-to-end processing pipeline for the proposed ResNet-1D--TCN single-channel sleep staging framework (E3 configuration).} The raw continuous EEG signal is sequentially preprocessed (band-pass filtered, clipped, and scaled), segmented into 30\,s epochs (3{,}000 samples), encoded into 128-dimensional feature vectors by a 1D-ResNet, and temporally modeled by a six-block non-causal TCN with a 253-epoch receptive field before final Softmax classification. The schematic was drawn in TikZ with OpenAI Codex assistance; it depicts processing steps, not measured signals or predictions}{figure.caption.2}{}}
